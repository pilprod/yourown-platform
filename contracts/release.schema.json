{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "workloadRef",
    "environmentRef",
    "imageDigest",
    "configurationSHA256",
    "sourceCommit"
  ],
  "properties": {
    "apiVersion": {
      "const": "platform.yourown/v1alpha1"
    },
    "kind": {
      "const": "Release"
    },
    "workloadRef": {
      "type": "string",
      "pattern": "^workload://[a-z][a-z0-9-]{0,62}$"
    },
    "environmentRef": {
      "type": "string",
      "pattern": "^environment://[a-z][a-z0-9-]{0,62}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "configurationSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
