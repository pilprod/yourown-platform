{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "secret-reference v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "secret"
  ],
  "properties": {
    "apiVersion": {
      "const": "platform.yourown/v1alpha1"
    },
    "kind": {
      "const": "SecretReference"
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ref",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "ref": {
          "type": "string",
          "pattern": "^secret://[a-z][a-z0-9-]{0,62}/[a-z][a-z0-9-]{0,62}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "not": {
            "pattern": "^(?:[Ll][Aa][Tt][Ee][Ss][Tt]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Aa][Ww][Ss][Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Aa][Ww][Ss][Pp][Rr][Ee][Vv][Ii][Oo][Uu][Ss])$"
          }
        }
      }
    }
  }
}
